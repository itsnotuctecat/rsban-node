name: Docker build

on:
  push:
    branches:
      - build-1
  pull_request:

jobs:
  docker:
    runs-on: ubuntu-latest

    steps:
      - name: Check
        uses: actions/checkout@v4

      - name: Buildx
        uses: docker/setup-buildx-action@v3

      - name: GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          file: scripts/docker/node/Dockerfile
          push: true
          tags: ghcr.io/${{ github.repository }}/rsban:latest
